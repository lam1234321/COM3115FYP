# CC-BOS (configurable)
#
# Copy this to `.env` (same directory as this file) and fill in your API
# credentials. Values may also be set in the shell environment.

# Primary provider (target model + judge). Any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Generator / translator provider (defaults to DeepSeek). If left blank, the
# primary provider above is used together with GENERATOR_MODEL/TRANSLATOR_MODEL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Models
TARGET_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
GENERATOR_MODEL=deepseek-chat
TRANSLATOR_MODEL=deepseek-chat

# Optional local inference via Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:8b

# Optional path for locally loaded models
LOCAL_MODEL_PATH=
DEVICE=cuda
