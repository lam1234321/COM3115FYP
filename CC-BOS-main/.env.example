# Copy to .env and fill in what you need.
#
# A single OPENAI_API_KEY / OPENAI_BASE_URL is used as the fallback for every
# role. Override a role only if it lives on a different endpoint.

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Generator: rewrites the query into Classical Chinese.
# Defaults to deepseek-chat, so normally set a DeepSeek key/base URL here.
GENERATOR_API_KEY=
GENERATOR_BASE_URL=
GENERATOR_MODEL=deepseek-chat

# Target: the model being tested.
TARGET_API_KEY=
TARGET_BASE_URL=
TARGET_MODEL=gpt-4o

# Judge: scores the target response with the 0-5 rubric.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=gpt-4o

# Translator: Classical Chinese -> modern Chinese -> English.
TRANSLATOR_API_KEY=
TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=deepseek-chat

# Optional
# RESULT_DIR=./result
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3:8b
