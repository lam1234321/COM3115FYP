# Copy this file to .env and fill in your own credentials.
# .env is git-ignored; never commit real API keys.

# Victim / target model (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TARGET_MODEL=gpt-4o

# Attacker / translator model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ATTACK_MODEL=deepseek-chat

# Judge and translator
JUDGE_MODEL=gpt-4o
TRANSLATE_MODEL=deepseek-chat

# Optional: run entirely offline (no API calls)
# CCBOS_MOCK=1
